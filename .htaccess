# Open Gateways - Main Site Configuration
# Clean URLs, caching, security, and compression
# Updated: March 2026

RewriteEngine On

# ==============================================
# BOT BLOCKING
# Block aggressive crawlers that generate server load
# (InMotion Hosting originally added these rules March 2026)
# ==============================================
RewriteCond %{HTTP_USER_AGENT} (meta-externalagent|PetalBot|DotBot|AhrefsBot|FeedValidator|SemrushBot|MJ12bot|BLEXBot|DataForSeoBot|serpstatbot|SEOkicks) [NC]
RewriteRule .* - [F,L]

# ==============================================
# FORCE HTTPS
# ==============================================
RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} !^(www\.)?dalecarley\.com$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# =============================================================================
# LEGACY URL REDIRECTS (pre-migration .shtml and CRE Loaded store)
# 301 redirects to reclaim Google-indexed URLs that now return 404.
# Most specific rules first; generic patterns last.
# =============================================================================

# --- Bare language directories (was 403: no index, directory listing off) ---
RewriteRule ^en/?$                        /en/welcome-to-opengateways    [R=301,L]
RewriteRule ^es/?$                        /es/bienvenido-a-opengateways  [R=301,L]

# --- Legacy root-level pages (pre-bilingual redesign, no /en/ or /es/) ---
RewriteRule ^channeling\.shtml$           /en/what-is-channeling         [R=301,L]
RewriteRule ^news\.shtml$                 /en/news                       [R=301,L]
RewriteRule ^contact\.shtml$              /en/contact-us                 [R=301,L]
RewriteRule ^private\.shtml$              /en/private-sessions           [R=301,L]
RewriteRule ^listen\.shtml$               /en/listen-to-baratta          [R=301,L]
RewriteRule ^welcome\.shtml$              /                              [R=301,L]
RewriteRule ^index\.shtml$                /                              [R=301,L]
RewriteRule ^default\.htm$                /                              [R=301,L]

# --- Legacy English pages with slugs that changed in the migration ---
RewriteRule ^en/testimonials-comments\.shtml$    /en/testimonials         [R=301,L]
RewriteRule ^en/introducing-dale\.shtml$         /en/meet-dale-carley     [R=301,L]
RewriteRule ^en/introducing-baratta\.shtml$      /en/meet-baratta         [R=301,L]
RewriteRule ^en/news-and-events\.shtml$          /en/news                 [R=301,L]
RewriteRule ^en/private-session\.shtml$          /en/private-sessions     [R=301,L]

# --- Legacy Spanish pages that used English slugs (pre-localization) ---
RewriteRule ^es/contact-us\.shtml$               /es/contactanos          [R=301,L]
RewriteRule ^es/testimonials-comments\.shtml$    /es/testimonios          [R=301,L]
RewriteRule ^es/introducing-dale\.shtml$         /es/conoce-a-dale-carley [R=301,L]
RewriteRule ^es/introducing-baratta\.shtml$      /es/conoce-a-baratta     [R=301,L]
RewriteRule ^es/news-and-events\.shtml$          /es/noticias             [R=301,L]
RewriteRule ^es/what-is-channeling\.shtml$       /es/que-es-canalizacion  [R=301,L]
RewriteRule ^es/listen-to-baratta\.shtml$        /es/escucha-a-baratta    [R=301,L]
RewriteRule ^es/private-session\.shtml$          /es/sesiones-privadas    [R=301,L]
RewriteRule ^es/media-dale-carley\.shtml$        /en/interview-with-dale  [R=301,L]

# --- Legacy CRE Loaded store → live shop subdomain ---
# All /store/... paths redirect to the shop (which handles language via cookie).
# Trailing ? strips any legacy query string like ?language=es.
RewriteRule ^store(/.*)?$                 https://shop.opengateways.com/?    [R=301,L]

# --- Generic .shtml → clean-URL fallback ---
# Catches any remaining legacy page matching /en/<slug>.shtml or /es/<slug>.shtml
# where the slug is unchanged between .shtml and modern .html versions.
RewriteRule ^(en|es)/([^/]+)\.shtml$      /$1/$2                         [R=301,L]
# --- Permanently gone: legacy /cgi-bin/ paths ---
# Returns 410 Gone (rather than 404) to signal Google to drop from its index.
# Empty substitution required when using [G] flag.
RewriteRule ^cgi-bin(/.*)?$               -                              [G,L]

# =============================================================================
# SECURITY HEADERS
# =============================================================================
<IfModule mod_headers.c>
  # Remove server signature
  Header unset Server
  Header unset X-Powered-By

  # Security headers
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS - Force HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# =============================================================================
# PRODUCTION CACHING
# =============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Browser caching headers
<IfModule mod_headers.c>
    # Cache static assets
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|svg|webp|js|css|mp3|woff|woff2)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # HTML files - no cache (ensures maintenance mode works immediately)
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# =============================================================================
# CLEAN URL REWRITING
# =============================================================================

# Remove .html extension from URLs (redirect to clean URL)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# Add .html extension internally for file serving
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ $1.html [NC,L]

# Handle language-specific redirects
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/([^.]+)$ en/$1.html [NC,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^es/([^.]+)$ es/$1.html [NC,L]

# =============================================================================
# DIRECTORY & FILE PROTECTION
# =============================================================================

# Prevent directory listing
Options -Indexes

# Block access to all dotfiles (.env, .git, .htpasswd, etc.)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block access to sensitive file extensions
<FilesMatch "(^#.*#|\.(bak|conf|config|dist|fla|in[ci]|ini|log|orig|psd|sh|sql|sw[op])|~)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Protect the database symlink directory
<IfModule mod_rewrite.c>
  RewriteRule ^assets/database/ - [F,L]
</IfModule>

# =============================================================================
# CHARACTER ENCODING & COMPRESSION
# =============================================================================

# Set default character encoding (important for Spanish content)
AddDefaultCharset UTF-8

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
